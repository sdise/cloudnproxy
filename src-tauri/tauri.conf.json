{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudNProxy",
  "version": "0.1.0",
  "identifier": "dev.cloudnproxy.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CloudNProxy — T5 云代理网关",
        "width": 1040,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "T5 云代理网关",
    "longDescription": "把百度 T5 云代理节点转换为本地标准 SOCKS5 代理。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
